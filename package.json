{
  "name": "memecoin-robinhood-chain",
  "version": "1.0.0",
  "private": true,
  "description": "ERC-20 minimal (offre fixe, sans owner) lancé sur Uniswap v3 d'un seul côté, liquidité verrouillée à vie, sur Robinhood Chain",
  "type": "module",
  "scripts": {
    "build": "hardhat build --build-profile production",
    "test": "hardhat test",
    "typecheck": "hardhat build && tsc --noEmit",
    "rehearsal": "hardhat run --network robinhoodFork scripts/00-rehearsal-fork.ts",
    "deploy:testnet": "hardhat run --network robinhoodTestnet --build-profile production scripts/01-deploy.ts",
    "deploy:mainnet": "hardhat run --network robinhood --build-profile production scripts/01-deploy.ts",
    "status:testnet": "hardhat run --network robinhoodTestnet scripts/04-status.ts",
    "wallet:mainnet": "hardhat run --network robinhood scripts/10-check-wallet.ts",
    "status:mainnet": "hardhat run --network robinhood scripts/04-status.ts",
    "release:testnet": "hardhat run --network robinhoodTestnet scripts/05-release.ts",
    "release:mainnet": "hardhat run --network robinhood scripts/05-release.ts",
    "fees:mainnet": "hardhat run --network robinhood scripts/09-fees.ts",
    "nft:deploy:testnet": "hardhat run --network robinhoodTestnet --build-profile production scripts/06-deploy-nft.ts",
    "nft:deploy:mainnet": "hardhat run --network robinhood --build-profile production scripts/06-deploy-nft.ts",
    "nft:reveal:testnet": "hardhat run --network robinhoodTestnet scripts/08-reveal.ts",
    "nft:reveal:mainnet": "hardhat run --network robinhood scripts/08-reveal.ts",
    "game:deploy:testnet": "hardhat run --network robinhoodTestnet --build-profile production scripts/07-deploy-game.ts",
    "game:deploy:mainnet": "hardhat run --network robinhood --build-profile production scripts/07-deploy-game.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.12",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.2",
    "@nomicfoundation/ignition-core": "^3.1.10",
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.8.5",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v2-periphery": "1.1.0-beta.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v4-core": "^1.0.2",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "hardhat": "^3.19.0",
    "mocha": "^12.0.0",
    "typescript": "~6.0.3"
  }
}
